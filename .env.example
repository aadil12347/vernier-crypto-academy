# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-secret-string-in-production

# Database
DB_PATH=./db/vernier.sqlite

# Payment Feature Toggles (Whop switched on in Phase 6)
ALLOW_SANDBOX_PAYMENTS=true
ENABLE_CRYPTO_MANUAL=true
ENABLE_CRYPTO_AUTO=false
ENABLE_LOCAL_PK_RAILS=true
WHOP_ENABLED=false

# Direct Crypto Wallets (Manual TxID Verification Queue)
CRYPTO_USDT_TRC20=TYourTronWalletAddressHereForLiveUse
CRYPTO_USDT_BEP20=0xYourBep20WalletAddressHereForLiveUse
CRYPTO_USDC_SOL=YourSolanaWalletAddressHereForLiveUse

# Optional Automated Crypto IPN (NOWPayments / Cryptomus)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional Local Pakistan Transfer Details (PKR rate + Manual Slip Review)
PKR_USD_RATE=278.5
PK_BANK_TITLE=VERNIER ACADEMY PK
PK_BANK_NAME=Meezan Bank / SadaPay
PK_BANK_IBAN=PK00MEZN0000000000000000
PK_JAZZCASH_NUMBER=0300-0000000

# Phase 6: Whop Live Credentials (Fill when going live)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_STARTER_1=plan_starter_1_placeholder
WHOP_PLAN_ACTION_25=plan_action_25_placeholder
WHOP_PLAN_ORDERFLOW_100=plan_orderflow_100_placeholder
WHOP_PLAN_VAULT_500=plan_vault_500_placeholder

