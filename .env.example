# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-secret-string-in-production

# Database (Firebase Cloud Firestore — paste Service Account details from Firebase Console)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Optional single-var alternative (raw JSON or base64 JSON):
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional (leave empty for default Standard database, or set named database ID for Enterprise):
FIREBASE_DATABASE_ID=
# Optional for local `firebase emulators:start --only firestore`:
FIRESTORE_EMULATOR_HOST=
DB_PATH=./db/vernier.sqlite

# Active Payment Rail (Whop Checkout exclusive during testing; other rails off)
WHOP_ENABLED=true
ALLOW_SANDBOX_PAYMENTS=false
ENABLE_CRYPTO_MANUAL=false
ENABLE_CRYPTO_AUTO=false
ENABLE_LOCAL_PK_RAILS=false

# Whop Checkout & Webhook Verification
WHOP_DEFAULT_PLAN_ID=plan_CTX7xd3gUPsgD
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=whsec_your_whop_webhook_secret
WHOP_PLAN_STARTER_1=plan_CTX7xd3gUPsgD
WHOP_PLAN_ACTION_25=
WHOP_PLAN_ORDERFLOW_100=
WHOP_PLAN_VAULT_500=
